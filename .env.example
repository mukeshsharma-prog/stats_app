# ---------------------------------------------------------------------------
# Stats App — local development environment
#
# COPY THIS FILE TO .env AND FILL IN THE BLANKS:  cp .env.example .env
#
# .env is gitignored (see .gitignore). This file is committed and must never
# contain a real secret — it is documentation of WHICH variables exist, not of
# what they are set to.
#
# Who reads this file:
#   - docker-compose  — automatically, from the repository root. This is the
#     main consumer.
#   - Keycloak realm import — indirectly. docker-compose passes these into the
#     Keycloak container, and docs/setup/keycloak-realm-statsapp.json resolves
#     them as ${env.NAME:default} placeholders at import time.
#   - Spring Boot — NOT automatically. Boot does not read .env files. When you
#     run a module with ./gradlew bootRun you must export these yourself:
#         set -a && source .env && set +a && ./gradlew :stats-api:bootRun
#
# Every variable name here matches a ${...} placeholder that already exists in
# a module's application.properties or in the realm JSON. If you add a variable,
# add the consumer in the same change — an unread variable is worse than no
# variable, because it looks configured and is not.
# ---------------------------------------------------------------------------


# === Keycloak — realm identity (Q8b, PROPOSED, awaiting ZC confirmation) =====
# These are names, not secrets. ADR-006 is ACCEPTED — the isolation decisions are
# settled. What is still awaited is ZC's confirmation of these NAMES (Q8b-2), and
# they are variables precisely so that closing it is a config change and never a
# code change. See docs/decisions/2B-ANSWERS-18AUG2026.md §4.

STATS_REALM_NAME=statsapp
STATS_REALM_DISPLAY_NAME=Datahub Core - Stats App (development)
STATS_API_CLIENT_ID=stats-api
STATS_INPUT_CLIENT_ID=stats-input
STATS_DEV_CLI_CLIENT_ID=stats-dev-cli
# stats.readOnly, NOT the bare `readOnly` placeholder from the v1.0 answer.
STATS_READ_ONLY_ROLE=stats.readOnly
STATS_INGEST_ROLE=stats.ingest

# Audience. Read by stats-api as ${STATS_API_AUDIENCE}. Rejecting a token minted
# for another audience is what stops a neighbouring service's token being replayed
# against this API, so this is a security control, not a label.
STATS_API_AUDIENCE=stats-api

# The tenant claim is single-valued and a String, on purpose. A multi-valued
# claim turns tenant isolation into `tenant IN (...)`, and one misconfigured
# user then reads several tenants with every test still green. (CLAUDE.md §6)
STATS_TENANT_CLAIM=tenant


# === Keycloak — issuer, consumed by stats-api ===============================
# Referenced as ${KEYCLOAK_ISSUER} in stats-api/src/main/resources/
# application.properties, deliberately with NO default so the module refuses to
# start rather than guessing a security posture.
#
# DEV: localhost. The app services sit behind the compose `apps` profile, so a
# plain `docker compose up` starts infrastructure only and you run the modules
# from your IDE. localhost:8080 is then what your browser, your curl and the
# module all see — no /etc/hosts edit, no surprises.
#
# `iss` is validated as a STRING, not fetched. So this value stays localhost even
# for a containerised module; what changes is only where that module fetches
# signing keys from — see KEYCLOAK_JWK_SET_URI below.
#
# PRODUCTION: replace with the real issuer, e.g.
#     KEYCLOAK_ISSUER=https://auth.zenner.example/realms/statsapp
# and leave KEYCLOAK_JWK_SET_URI unset so Spring uses OIDC discovery normally.
KEYCLOAK_ISSUER=http://localhost:8080/realms/statsapp

# ONLY needed when you run the modules IN containers (`docker compose --profile
# apps up`). A container cannot reach the host's localhost:8080, but it can reach
# `keycloak:8080` on the compose network. Setting this makes Spring fetch the JWK
# set over the compose network while still requiring `iss` to equal
# KEYCLOAK_ISSUER above.
#
# Leave it EMPTY for host-run modules and for production, where discovery from
# the real issuer URL is correct. Compose sets it on stats-api for you.
KEYCLOAK_JWK_SET_URI=

KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=


# === Input endpoint authentication (Q8a — DEFERRED BY DECISION) =============
# Read by stats-input as ${STATS_INPUT_AUTH_MODE}. One of: none | mtls | oauth2.
#
# The property has NO DEFAULT IN CODE, deliberately: a deployment that does not
# set it must fail to start, so `none` has to be typed by a person. mode=none also
# logs a WARN on every startup, and a test refuses to start under the `prod`
# profile with it.
#
# RISK ACCEPTED: while this is `none`, anything that can reach the Input port can
# write statistics. That is fine on this local dev stack and nowhere else. Q8a-2
# must close before any shared deployment. (ADR-006, 2B-ANSWERS §3)
STATS_INPUT_AUTH_MODE=none


# === Keycloak — client secrets =============================================
# SECRETS. Dev-only values in .env; never reuse in a deployed environment.
# stats-dev-cli is a public client and has no secret by design.

STATS_API_CLIENT_SECRET=
STATS_INPUT_CLIENT_SECRET=


# === Keycloak — fixture user identities ====================================
# NOT secrets. Variables because these names are ours to choose: ZC returned the
# naming to engineering ("you suggest this as per your knowledge" — Q8b), so the
# realm should never need a code edit to rename anything.
#
# Note the coupling: the SRS, docs/decisions/2B-ANSWERS-18AUG2026.md and the
# isolation tests all refer to these users by the default names below. Rename
# here and in those tests in the same change, or a test starts authenticating as
# a user that no longer exists.

STATS_ALPHA_READER_USERNAME=alpha-reader
STATS_BETA_READER_USERNAME=beta-reader
STATS_NO_ROLE_USERNAME=no-role
STATS_NO_TENANT_USERNAME=no-tenant
STATS_EMPTY_TENANT_USERNAME=empty-tenant
STATS_USER_EMAIL_DOMAIN=stats.local

# === Keycloak — fixture user passwords ======================================
# SECRETS. The four users are not filler: each one is a test.
#   alpha-reader / beta-reader — the cross-tenant isolation pair
#   no-role                    — proves an authenticated caller without
#                                stats.readOnly gets 403
#   no-tenant                  — proves a token with NO tenant claim at all fails
#                                CLOSED, not "all tenants"
#   empty-tenant               — proves an EMPTY tenant claim fails closed too.
#                                A separate user on purpose: absent and empty are
#                                different code paths, and ADR-006 release-gates
#                                both. One user cannot cover two.
# The usernames themselves are in the block above.

STATS_ALPHA_READER_PASSWORD=
STATS_BETA_READER_PASSWORD=
STATS_NO_ROLE_PASSWORD=
STATS_NO_TENANT_PASSWORD=
STATS_EMPTY_TENANT_PASSWORD=


# === Keycloak — fixture tenant ids ==========================================
# NOT secrets. Variables so a developer can point the fixtures at whatever
# tenant values their local data set uses.
#
# These two MUST differ from each other. The sample data in the SRS often has
# the same value in `tenant` and `maintenant`, and an implementation that
# filters on the wrong field passes every test written against those samples
# and leaks data in production. (CLAUDE.md §6 — highest-risk item in the project)

STATS_TENANT_A_ID=tenant-alpha
STATS_TENANT_B_ID=tenant-beta


# === Stats Writer ===========================================================
# Which stat type this writer instance consumes (ADR-003 D8). One image, one
# deployment per type in production; `all` keeps the local stack to one container.
STAT_TYPE=all

# DLQ depth alert threshold for lorastats ONLY. Read by stats-writer as
# ${STATS_DLQ_ALERT_DEPTH_LORASTATS}; it has no in-code default on purpose.
#
# Every other type alerts at stats.writer.dlq.alert-depth.default=0, because a
# single dead-lettered record is a real record nobody will resend. lorastats
# cannot use that number: the schema encodes ONE of the three payload dialects
# production sends and the other two dead-letter by design (ADR-007 §4), so this
# queue sits permanently non-empty until ZC answers Q15a. A uniform threshold
# would therefore either page continuously on lorastats or, if raised globally,
# go deaf on the four types where depth > 0 means something.
#
# The value below is a placeholder for the local stack, NOT an operational
# number — size it from observed steady-state depth, and alert on OLDEST MESSAGE
# AGE alongside it (ADR-002 §12). Do not "fix" a lorastats spike by widening the
# schema; that is the option ADR-007 §4 considered and rejected.
STATS_DLQ_ALERT_DEPTH_LORASTATS=0


# === PostgreSQL =============================================================
# Referenced by stats-api/src/main/resources/application.properties.
# The read-only user is not a convention — "only Module 2 writes" (STA-32) is
# enforced by GRANT, so a mistake in code fails loudly at the database.

POSTGRES_URL=jdbc:postgresql://postgres:5432/statsdb
POSTGRES_DB=statsdb
POSTGRES_RO_USER=stats_ro
POSTGRES_RO_PASSWORD=

# Write-capable user. Read by stats-writer (the ONLY module with write access,
# STA-32) AND by the postgres image itself, which creates this role at first
# start. One name, both jobs — do not split them.
POSTGRES_USER=stats
POSTGRES_PASSWORD=


# === RabbitMQ ===============================================================
# Referenced by stats-input/src/main/resources/application.properties.

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=stats
RABBITMQ_PASSWORD=

# The rabbitmq image reads its own variable names. These MUST match the pair
# above — the modules authenticate with RABBITMQ_USER/RABBITMQ_PASSWORD against
# the account the broker creates from RABBITMQ_DEFAULT_USER/PASS.
RABBITMQ_DEFAULT_USER=stats
RABBITMQ_DEFAULT_PASS=
