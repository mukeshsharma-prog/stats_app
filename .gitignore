# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# IDE — editor settings stay on each developer's machine
.idea/
.vscode/
*.iml
*.ipr
*.iws
out/
bin/

# OS
.DS_Store

# Local Python tooling environment. Java/Gradle still use the repository wrapper.
.venv/
__pycache__/
*.py[cod]

# Secrets never belong in the repository — they come from the environment.
# See CONTRIBUTING.md.
*.env
.env
.env.bak*
postman/*.private.postman_environment.json

# Local task tracker; maintained outside the source repository.
Stats_App_Tracker.xlsx
~$Stats_App_Tracker.xlsx

# Generated OpenAPI documentation bundle — BOTH contracts on one page.
# Regenerate from the YAML, never edit or commit it — a checked-in bundle is stale the
# moment docs/contracts/openapi*.yaml changes, and it is 350 KB of noise in every
# diff. CI uploads it as the `stats-api-v1-draft` workflow artifact:
#     docs/contracts/build-html.sh
stats-api-v1-draft.html

# Generated offline Docker distribution archives. Rebuild from
# docker/package-bundle.sh; never commit images or generated credentials.
dist/
