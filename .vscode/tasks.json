{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Gradle: Build all",
      "type": "shell",
      "command": "./gradlew build",
      "windows": {
        "command": ".\\gradlew.bat build"
      },
      "group": "build",
      "problemMatcher": ["$gradle"]
    },
    {
      "label": "Gradle: Unit tests",
      "type": "shell",
      "command": "./gradlew test",
      "windows": {
        "command": ".\\gradlew.bat test"
      },
      "group": "test",
      "problemMatcher": ["$gradle"]
    },
    {
      "label": "Gradle: Integration tests",
      "type": "shell",
      "command": "./gradlew integrationTest",
      "windows": {
        "command": ".\\gradlew.bat integrationTest"
      },
      "group": "test",
      "problemMatcher": ["$gradle"]
    },
    {
      "label": "Docker: Start local infrastructure",
      "type": "shell",
      "command": "docker compose -f docker/docker-compose.yml up -d",
      "problemMatcher": []
    },
    {
      "label": "Docker: Stop local infrastructure",
      "type": "shell",
      "command": "docker compose -f docker/docker-compose.yml down",
      "problemMatcher": []
    },
    {
      "label": "Run: Stats Input",
      "type": "shell",
      "command": "./gradlew :stats-input:bootRun",
      "windows": {
        "command": ".\\gradlew.bat :stats-input:bootRun"
      },
      "isBackground": true,
      "problemMatcher": ["$gradle"]
    },
    {
      "label": "Run: Stats Writer",
      "type": "shell",
      "command": "./gradlew :stats-writer:bootRun",
      "windows": {
        "command": ".\\gradlew.bat :stats-writer:bootRun"
      },
      "isBackground": true,
      "problemMatcher": ["$gradle"]
    },
    {
      "label": "Run: Stats API",
      "type": "shell",
      "command": "./gradlew :stats-api:bootRun",
      "windows": {
        "command": ".\\gradlew.bat :stats-api:bootRun"
      },
      "isBackground": true,
      "problemMatcher": ["$gradle"]
    }
  ]
}
