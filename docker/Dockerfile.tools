# Stats App — the hand-run tools image for the Docker bundle (DL-171).
#
# Everything MANUAL.md and docker/demo.sh need besides Docker itself — bash, curl, jq and
# a Docker CLI — plus demo.sh, the fixtures it posts and the walkthrough helpers. It is
# what lets the person the bundle is shared with follow the walkthrough or run the demo
# with nothing installed but Docker.
#
#   ./docker/shell.sh       a shell with the helpers loaded   (MANUAL.md)
#   ./docker/run-demo.sh    docker/demo.sh, ten steps          (step 10 stops RabbitMQ)
#
# It runs INSIDE the bundle's compose network and reaches the services by name. The
# `docker exec` / `docker logs` / `docker stop` calls go through the host's Docker
# socket, which the compose service mounts. No credential is baked in: compose mounts the
# bundle's .env read-only at /bundle/.env.
#
# Built from the repository root (the fixtures are docs/schemas/fixtures, the one copy):
#   docker buildx build -f docker/Dockerfile.tools -t stats-app/stats-tools:dev .
FROM alpine:3.22

RUN apk add --no-cache bash curl jq docker-cli

WORKDIR /tools
COPY docs/schemas/fixtures         ./docs/schemas/fixtures
COPY docker/demo.sh                ./docker/demo.sh
COPY docker/stats-helpers.sh       ./docker/stats-helpers.sh
COPY docker/tools-entrypoint.sh    ./docker/tools-entrypoint.sh

ENTRYPOINT ["bash", "/tools/docker/tools-entrypoint.sh"]
CMD ["shell"]
