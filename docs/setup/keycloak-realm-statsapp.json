{
  "realm": "${STATS_REALM_NAME:statsapp}",
  "enabled": true,
  "displayName": "${STATS_REALM_DISPLAY_NAME:Datahub Core - Stats App (development)}",
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "roles": {
    "realm": [
      {
        "name": "${STATS_READ_ONLY_ROLE:stats.readOnly}",
        "description": "Read tenant-scoped statistics through the Stats API. GET only."
      },
      {
        "name": "${STATS_INGEST_ROLE:stats.ingest}",
        "description": "Publish statistics through the Stats Input endpoint. Service accounts only."
      }
    ]
  },
  "clients": [
    {
      "clientId": "${STATS_API_CLIENT_ID:stats-api}",
      "name": "Stats API (resource server)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "secret": "${STATS_API_CLIENT_SECRET:dev-only-stats-api-secret}",
      "protocolMappers": [
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "${STATS_TENANT_CLAIM:tenant}",
            "claim.name": "${STATS_TENANT_CLAIM:tenant}",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "false"
          }
        }
      ],
      "attributes": {
        "post.logout.redirect.uris": "+"
      }
    },
    {
      "clientId": "${STATS_INPUT_CLIENT_ID:stats-input}",
      "name": "Stats Input (Heimdal ingress)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "${STATS_INPUT_CLIENT_SECRET:dev-only-stats-input-secret}",
      "protocolMappers": [
        {
          "name": "audience-stats-input",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "${STATS_INPUT_CLIENT_ID:stats-input}",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "${STATS_DEV_CLI_CLIENT_ID:stats-dev-cli}",
      "name": "Local token helper (password grant)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocolMappers": [
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "${STATS_TENANT_CLAIM:tenant}",
            "claim.name": "${STATS_TENANT_CLAIM:tenant}",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "false"
          }
        },
        {
          "name": "audience-stats-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "${STATS_API_CLIENT_ID:stats-api}",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "${STATS_ALPHA_READER_USERNAME:alpha-reader}",
      "enabled": true,
      "emailVerified": true,
      "firstName": "${STATS_ALPHA_READER_USERNAME:alpha-reader}",
      "lastName": "dev",
      "email": "${STATS_ALPHA_READER_USERNAME:alpha-reader}@${STATS_USER_EMAIL_DOMAIN:stats.local}",
      "credentials": [
        {
          "type": "password",
          "value": "${STATS_ALPHA_READER_PASSWORD:alpha}",
          "temporary": false
        }
      ],
      "attributes": {
        "tenant": [
          "${STATS_TENANT_A_ID:tenant-alpha}"
        ]
      },
      "realmRoles": [
        "${STATS_READ_ONLY_ROLE:stats.readOnly}"
      ]
    },
    {
      "username": "${STATS_BETA_READER_USERNAME:beta-reader}",
      "enabled": true,
      "emailVerified": true,
      "firstName": "${STATS_BETA_READER_USERNAME:beta-reader}",
      "lastName": "dev",
      "email": "${STATS_BETA_READER_USERNAME:beta-reader}@${STATS_USER_EMAIL_DOMAIN:stats.local}",
      "credentials": [
        {
          "type": "password",
          "value": "${STATS_BETA_READER_PASSWORD:beta}",
          "temporary": false
        }
      ],
      "attributes": {
        "tenant": [
          "${STATS_TENANT_B_ID:tenant-beta}"
        ]
      },
      "realmRoles": [
        "${STATS_READ_ONLY_ROLE:stats.readOnly}"
      ]
    },
    {
      "username": "${STATS_NO_ROLE_USERNAME:no-role}",
      "enabled": true,
      "emailVerified": true,
      "firstName": "${STATS_NO_ROLE_USERNAME:no-role}",
      "lastName": "dev",
      "email": "${STATS_NO_ROLE_USERNAME:no-role}@${STATS_USER_EMAIL_DOMAIN:stats.local}",
      "credentials": [
        {
          "type": "password",
          "value": "${STATS_NO_ROLE_PASSWORD:norole}",
          "temporary": false
        }
      ],
      "attributes": {
        "tenant": [
          "${STATS_TENANT_A_ID:tenant-alpha}"
        ]
      },
      "realmRoles": []
    },
    {
      "username": "${STATS_NO_TENANT_USERNAME:no-tenant}",
      "enabled": true,
      "emailVerified": true,
      "firstName": "${STATS_NO_TENANT_USERNAME:no-tenant}",
      "lastName": "dev",
      "email": "${STATS_NO_TENANT_USERNAME:no-tenant}@${STATS_USER_EMAIL_DOMAIN:stats.local}",
      "credentials": [
        {
          "type": "password",
          "value": "${STATS_NO_TENANT_PASSWORD:notenant}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "${STATS_READ_ONLY_ROLE:stats.readOnly}"
      ]
    },
    {
      "username": "${STATS_EMPTY_TENANT_USERNAME:empty-tenant}",
      "enabled": true,
      "emailVerified": true,
      "firstName": "${STATS_EMPTY_TENANT_USERNAME:empty-tenant}",
      "lastName": "dev",
      "email": "${STATS_EMPTY_TENANT_USERNAME:empty-tenant}@${STATS_USER_EMAIL_DOMAIN:stats.local}",
      "credentials": [
        {
          "type": "password",
          "value": "${STATS_EMPTY_TENANT_PASSWORD:emptytenant}",
          "temporary": false
        }
      ],
      "attributes": {
        "tenant": [
          ""
        ]
      },
      "realmRoles": [
        "${STATS_READ_ONLY_ROLE:stats.readOnly}"
      ]
    }
  ]
}
