        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Confirm latency, not throughput, is what turns a burst into 503s (T-048).",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
