    {
      "name": "3 — Read API end to end",
      "item": [
        {
          "name": "GET lorastats by uid (poll until Writer commits)",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{alphaToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{apiBaseUrl}}/stats/lorastats/{{uidLora}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const attempt = Number(pm.environment.get(\"pollLora\") || 0);",
                  "if (pm.response.code === 404 && attempt < 12) {",
                  "  pm.environment.set(\"pollLora\", attempt + 1);",
                  "  postman.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "  pm.environment.unset(\"pollLora\");",
                  "  pm.test(\"lorastats persisted and readable\", () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().uid).to.eql(pm.environment.get(\"uidLora\"));",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
