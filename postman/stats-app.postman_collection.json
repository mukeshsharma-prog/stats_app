{
  "info": {
    "_postman_id": "d261dd99-4be8-458c-b5c1-a4d207a30598",
    "name": "Stats App — Complete Local Acceptance",
    "description": "End-to-end verification of health, Keycloak authentication, both ingest doors, lorastats/sysstats/omsstats persistence and reads, RabbitMQ topology/consumers, and API failure contracts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get(\"runId\")) {",
          "  const runId = Date.now().toString(36) + \"-\" + Math.random().toString(16).slice(2, 10);",
          "  pm.environment.set(\"runId\", runId);",
          "  pm.environment.set(\"uidLora\", \"postman-lora-\" + runId);",
          "  pm.environment.set(\"uidSys\", \"postman-sys-\" + runId);",
          "  pm.environment.set(\"uidOms\", \"postman-oms-\" + runId);",
          "  pm.environment.set(\"uidExternal\", \"postman-external-\" + runId);",
          "}",
          "const now = Math.floor(Date.now() / 1000);",
          "pm.environment.set(\"nowEpoch\", now);",
          "pm.environment.set(\"fromEpoch\", now - 120);",
          "pm.environment.set(\"toEpoch\", now + 120);",
          "pm.environment.set(\"expiresOn\", new Date((now + 86400) * 1000).toISOString());"
        ]
      }
    }
  ],
