    {
      "name": "5 — RabbitMQ and Writer evidence",
      "item": [
        {
          "name": "RabbitMQ queues, durability, and consumers",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{rabbitUsername}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{rabbitPassword}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{rabbitBaseUrl}}/api/queues/%2F"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const queues = pm.response.json();",
                  "const byName = Object.fromEntries(queues.map(q => [q.name, q]));",
                  "const types = [\"lorastats\", \"sysstats\", \"omsstats\"];",
                  "const expected = types.flatMap(type => [",
                  "  \"app_statsstore.\" + type,",
                  "  \"app_statsstore.\" + type + \".retry.1\",",
                  "  \"app_statsstore.\" + type + \".retry.2\",",
                  "  \"app_statsstore.\" + type + \".retry.3\",",
                  "  \"app_statsstore.\" + type + \".dlq\"",
                  "]);",
                  "pm.test(\"all 15 queues exist\", () => expected.forEach(name => pm.expect(byName, name).to.have.property(name)));",
                  "pm.test(\"all queues are durable quorum queues\", () => expected.forEach(name => { pm.expect(byName[name].durable, name).to.eql(true); pm.expect(byName[name].arguments[\"x-queue-type\"], name).to.eql(\"quorum\"); }));",
                  "pm.test(\"each main queue has a consumer\", () => types.forEach(type => pm.expect(byName[\"app_statsstore.\" + type].consumers, type).to.be.above(0)));",
                  "pm.test(\"main queues drained\", () => types.forEach(type => pm.expect(byName[\"app_statsstore.\" + type].messages, type).to.eql(0)));",
                  "pm.test(\"DLQs stayed empty\", () => types.forEach(type => pm.expect(byName[\"app_statsstore.\" + type + \".dlq\"].messages, type).to.eql(0)));"
                ]
              }
            }
          ]
        },
        {
          "name": "Writer persistence metrics",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{writerBaseUrl}}/actuator/prometheus"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const metrics = pm.response.text();",
                  "[\"lorastats\", \"sysstats\", \"omsstats\"].forEach(type => {",
                  "  pm.test(type + \" persisted counter is positive\", () => {",
                  "    const match = metrics.match(new RegExp('records_persisted_total\\\\{[^}]*type=\"' + type + '\"[^}]*\\\\}\\\\s+([0-9.]+)'));",
                  "    pm.expect(match, type + \" series\").not.to.eql(null);",
                  "    pm.expect(Number(match[1]), type + \" count\").to.be.above(0);",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
