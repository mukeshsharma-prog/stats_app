                "type": "text/javascript",
                "exec": [
                  "pm.test(\"publisher-confirmed acceptance\", () => pm.expect(pm.response.code).to.be.oneOf([200, 202]));",
                  "pm.test(\"trace id returned\", () => pm.expect(pm.response.headers.get(\"X-Trace-Id\")).to.be.a(\"string\").and.not.empty);",
